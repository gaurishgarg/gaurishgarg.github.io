<h2 style="text-align: center;"> Editing Design and Evaluation of E-SPARX Technique for Selection of Small, Distant and Interconnected Targets in Dense Virtual Environments</h2>
<br>
<div class ="form-group">
             <form method="POST" action="/updateproj" enctype="multipart/form-data">
                <div>
                  <label for="title" class="form-label">Title</label>
                  <input type="text" class="form-control" name="title" value="Design and Evaluation of E-SPARX Technique for Selection of Small, Distant and Interconnected Targets in Dense Virtual Environments"  required>                  
                </div>

                <div>
                  <label for="model" class="form-label">GLB Model</label>
                  <input type="file" class="form-control" name="model" required>                  
                </div>

                  <div>
                  <label for="rep_image" class="form-label">Choose Representational Image</label>
                  <input class="form-control" type="file" name="rep_image" accept="image/*" required>
                </div>

                <div>
                  <label for="summary" class="form-label">Summary</label>
                  <input type="text" class="form-control"  name="summary" value="ATM Paper Demo 123" required>                  
                </div>

                <div>
                  <label for="link" class="form-label">Itch/Github Link</label>
                  <input type="url" class="form-control"  name="link" value="https://github.com/gaurishgarg"  required>                  
                </div>

                <div>
                  <label for="video" class="form-label">Video URL</label>
                  <input type="url" class="form-control"  name="video" value="">                  
                </div>

                <div>
                  <label for="html" class="form-label">Custom HTML</label>
                  <input type="text" class="form-control" name="html" value=""> 
                </div>



                <div>
                  <label for="icon" class="form-label">Choose Relevant Icon</label>
                  <input class="form-control" type="file" name="icon" accept="image/*" required>
                </div>   
                
                 <input type="hidden" value="1" name="id">


               

                <div class="d-flex justify-content-center mt-3">
                  <button type="submit" class="btn btn-primary">Submit</button>
                </div>


             </form>
