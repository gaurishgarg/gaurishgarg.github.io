<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gaurish Garg</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link href="https://unpkg.com/grapesjs/dist/css/grapes.min.css" rel="stylesheet"/>
        <script src="https://unpkg.com/grapesjs"></script>
            <script src="https://unpkg.com/grapesjs-blocks-basic"></script>



    <link rel="stylesheet" href="static/style.css">

        <style>
      #blocks {
        width: 260px; 
        height: 100vh; 
        overflow-y: auto; 
        background: #2f2f2f;
        float: right;
      }
      #gjs {
        height: 100vh;
      }
    </style>
  </head>
  <body>
    <div class="container" id="main_container">

       <div id="gjs" style="height:100vh;"></div>




       

    </div>
    <script>
const editor = grapesjs.init({
  container: "#gjs",
  height: "100vh",
  storageManager: false,
  plugins: ["gjs-blocks-basic"],
    pluginOpts: {
          "gjs-blocks-basic": { flexGrid: true }
        }
});

/* ============================================
   ADD "DOWNLOAD HTML" BUTTON TO TOP PANEL
============================================= */

editor.Panels.addButton('options', {
  id: 'download-html',
  className: 'fa fa-download',
  command: 'download-html',
  attributes: { title: 'Download HTML' }
});


/* ============================================
   COMMAND: DOWNLOAD HTML
============================================= */

editor.Commands.add('download-html', {
  run(editor, sender) {
      sender && sender.set('active', false);

      const html = editor.getHtml();
      const css = editor.getCss();

      const fullHtml = `
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
${css}
</style>
</head>
<body>
${html}
</body>
</html>`;

      const blob = new Blob([fullHtml], { type: "text/html" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = "page.html";
      link.click();
  }
});


 editor.Panels.addPanel({
        id: 'blocks-panel',
      });
  
editor.Blocks.render();

/* ============================
   CUSTOM MEDIA BLOCKS
============================= */


editor.BlockManager.add("gif-upload-block", {
  label: "GIF Upload",
  category: "Media",
  activate: true,
  content: `<div class="gif-dropzone" 
                style="border:2px dashed #999; padding:20px; text-align:center;">
              Click to upload GIF
            </div>`,
});


// Event: When GIF dropzone is clicked → open file picker
editor.on("component:selected", comp => {
  if (!comp) return;
  if (comp.getEl() && comp.getEl().classList.contains("gif-dropzone")) {

    let input = document.createElement("input");
    input.type = "file";
    input.accept = "image/gif";

    input.onchange = () => {
      let file = input.files[0];
      let reader = new FileReader();

      reader.onload = e => {
        comp.replaceWith(`
          <img src="${e.target.result}" 
               style="width:100%; max-width:100%;" />
        `);
      };
      reader.readAsDataURL(file);
    };

    input.click();
  }
});


document.getElementById("blocks").appendChild(editor.Blocks.getContainer());
</script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
  </body>
</html>